# .env.example (깃허브에 올라가는 공유용 템플릿)
MONGODB_URL=mongodb+srv://<USERNAME>:<PASSWORD>@cluster.mongodb.net/
DB_NAME=wbb_db

# 파인튜닝된 KoBERT 모델이 저장된 로컬 경로
KOBERT_MODEL_DIR=./kobert_wbb_model

# 영상 프레임에서 채팅창을 잘라낼 좌표 (left, top, right, bottom / 0~1 비율)
# 방송/플랫폼마다 채팅창 위치가 다르므로 필요 시 조정
CHAT_CROP_BOX=0.15,0.65,0.60,0.98

PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True